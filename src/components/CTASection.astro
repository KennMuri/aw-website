---
import type { ColorScheme } from './ModernHero.astro';

export interface Props {
  title?: string;
  description?: string;
  primaryCta?: {
    text: string;
    href: string;
  };
  secondaryCta?: {
    text: string;
    href: string;
  };
  disclaimer?: string;
  colorScheme?: ColorScheme;
}

const { 
  title = "Secure Your Organization Today",
  description = "Don't wait for a security incident.",
  primaryCta = {
    text: "Book An Audit",
    href: "/audits"
  },
  secondaryCta = {
    text: "Explore Sentry",
    href: "/sentry"
  },
  disclaimer = "Free consultation • W3OS & SEAL compliant • Enterprise-grade security",
  colorScheme
} = Astro.props;

const cs = colorScheme;
---

<section class="cta-section section" style={cs ? `
  --cta-button-primary-start: ${cs.button.primary.start};
  --cta-button-primary-end: ${cs.button.primary.end};
  --cta-button-primary-hover-start: ${cs.button.primaryHover.start};
  --cta-button-primary-hover-end: ${cs.button.primaryHover.end};
  --cta-button-border-color: ${cs.button.border.color};
  --cta-button-border-opacity: ${cs.button.border.opacity};
  --cta-title-gradient-color: ${cs.button.primary.start};
` : ''}>
  <div class="container">
    <div class="cta-content text-center">
      <h2 class="h2 cta-title">
        {title}
      </h2>
      <p class="body-large cta-description">
        {description} Book an operational security audit to identify and mitigate risk.
      </p>
      <div class="cta-buttons flex gap-4 justify-center">
        <a 
          href={primaryCta.href} 
          class="btn btn-primary btn-lg"
          target={primaryCta.href.startsWith('http') ? '_blank' : undefined}
          rel={primaryCta.href.startsWith('http') ? 'noopener noreferrer' : undefined}
        >
          {primaryCta.text}
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M6 12L10 8L6 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        {secondaryCta && (
          <a 
            href={secondaryCta.href} 
            class="btn btn-secondary btn-lg"
            target={secondaryCta.href.startsWith('http') ? '_blank' : undefined}
            rel={secondaryCta.href.startsWith('http') ? 'noopener noreferrer' : undefined}
          >
            {secondaryCta.text}
          </a>
        )}
      </div>
      {disclaimer && (
        <p class="body-small cta-disclaimer">
          {disclaimer}
        </p>
      )}
    </div>
  </div>
</section>

<style>
  .cta-section {
    padding: var(--spacing-3) 0;
    background: var(--color-background-primary);
  }
  
  .cta-content {
    max-width: 800px;
    width: 100%;
    margin: 0 auto;
    padding: var(--spacing-3) var(--spacing-4);
    background: var(--color-background-secondary);
    border: 1px solid var(--color-border-primary);
    border-radius: var(--radius-lg);
    transition: all var(--transition-base);
    position: relative;
    z-index: 1;
    box-sizing: border-box;
  }

  /* Mobile/tablet-only: prevent section box from being cut off — match container width. */
  @media (max-width: 768px) {
    .cta-content {
      padding: var(--spacing-5) var(--spacing-4);
      max-width: 100%;
      width: 100%;
      box-sizing: border-box;
    }
    .cta-description {
      max-width: 100%;
    }
  }
  @media (max-width: 480px) {
    .cta-content {
      padding: var(--spacing-4) 12px;
      max-width: 100%;
      width: 100%;
      box-sizing: border-box;
    }
  }
  
  .cta-content:hover {
    border-color: rgba(var(--cta-button-border-color, 139, 92, 246), var(--cta-button-border-opacity, 0.3));
    box-shadow: 0 0 0 1px rgba(var(--cta-button-border-color, 139, 92, 246), calc(var(--cta-button-border-opacity, 0.3) * 0.5)), 
                0 4px 20px rgba(var(--cta-button-primary-start, 147, 51, 234), 0.3);
    transform: translateY(-2px);
  }
  
  .cta-title {
    margin-bottom: var(--spacing-4);
    color: var(--color-text-primary);
    background: linear-gradient(135deg, var(--color-text-primary) 0%, rgb(var(--cta-title-gradient-color, 139, 92, 246)) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  
  .cta-description {
    margin-bottom: var(--spacing-10);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }
  
  .cta-buttons {
    display: flex;
    gap: var(--spacing-3);
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: var(--spacing-2); /* Consistent: buttons → disclaimer */
  }
  
  .cta-disclaimer {
    color: var(--color-text-secondary);
    opacity: 0.8;
    margin-top: 0;
    margin-bottom: 0;
  }
  
  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-2);
    padding: var(--spacing-4) var(--spacing-6);
    border-radius: var(--radius-lg);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
    transition: all var(--transition-base);
    cursor: pointer;
    border: none;
    font-family: inherit;
  }
  
  .cta-buttons .btn-primary {
    background: linear-gradient(135deg, rgb(var(--cta-button-primary-start, 147, 51, 234)) 0%, rgb(var(--cta-button-primary-end, 168, 85, 247)) 100%);
    color: var(--color-text-primary);
    border: 1px solid rgba(var(--cta-button-border-color, 139, 92, 246), var(--cta-button-border-opacity, 0.4));
    border-radius: var(--radius-full);
    box-shadow: 0 0 0 1px rgba(var(--cta-button-border-color, 139, 92, 246), calc(var(--cta-button-border-opacity, 0.4) * 0.5)), 
                0 4px 20px rgba(var(--cta-button-primary-start, 147, 51, 234), 0.3);
    transition: all var(--transition-base);
  }
  
  .cta-buttons .btn-primary:hover {
    background: linear-gradient(135deg, rgb(var(--cta-button-primary-hover-start, 168, 85, 247)) 0%, rgb(var(--cta-button-primary-hover-end, 192, 132, 252)) 100%);
    border-color: rgba(var(--cta-button-border-color, 139, 92, 246), calc(var(--cta-button-border-opacity, 0.4) + 0.1));
    box-shadow: 0 0 0 1px rgba(var(--cta-button-border-color, 139, 92, 246), calc(var(--cta-button-border-opacity, 0.4) + 0.1)), 
                0 8px 32px rgba(var(--cta-button-primary-start, 147, 51, 234), 0.4);
    transform: translateY(-2px);
    transition: all var(--transition-base);
  }

  .cta-buttons .btn-primary:active {
    transform: translateY(0) scale(0.98);
    transition: all var(--transition-fast);
  }
  
  .cta-buttons .btn-primary:focus {
    outline: none;
  }
  
  .cta-buttons .btn-primary:focus-visible {
    outline: 2px solid var(--color-primary-400);
    outline-offset: 2px;
  }
  
  .cta-buttons .btn-primary svg {
    transition: transform var(--transition-base);
  }
  
  .cta-buttons .btn-primary:hover svg {
    transform: translateX(2px);
  }
  
  .cta-buttons .btn-secondary {
    background: var(--color-background-glass-medium);
    color: var(--color-text-primary);
    border: 1px solid var(--color-border-primary);
    border-radius: var(--radius-full);
    backdrop-filter: var(--backdrop-blur-base);
    transition: all var(--transition-base);
  }
  
  .cta-buttons .btn-secondary:hover {
    background: var(--color-background-glass-strong);
    border-color: var(--color-border-strong);
    box-shadow: var(--shadow-elevation-low);
    transform: translateY(-2px);
  }
  
  .cta-buttons .btn-secondary:focus {
    outline: none;
  }
  
  .cta-buttons .btn-secondary:focus-visible {
    outline: 2px solid var(--color-primary-400);
    outline-offset: 2px;
  }
  
  .btn-lg {
    padding: var(--spacing-4) var(--spacing-8);
    font-size: var(--font-size-lg);
    border-radius: var(--radius-full);
    min-height: 48px;
  }
  
  .btn svg {
    width: 16px;
    height: 16px;
  }
  
  @media (max-width: 767px) {
    .cta-buttons {
      flex-direction: column;
      align-items: center;
    }
    
    .btn {
      width: 100%;
      max-width: 300px;
      justify-content: center;
    }
    
    .cta-title {
      font-size: var(--font-size-4xl);
    }
  }
</style>
