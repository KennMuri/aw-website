---
export interface Props {
  title?: string;
  description?: string;
  primaryCta?: {
    text: string;
    href: string;
  };
  secondaryCta?: {
    text: string;
    href: string;
  };
  disclaimer?: string;
}

const { 
  title = "Secure Your Organization Today",
  description = "Don't wait for a security incident.",
  primaryCta = {
    text: "Book An Audit",
    href: "/audits"
  },
  secondaryCta = {
    text: "Explore Sentry",
    href: "/sentry"
  },
  disclaimer = "Free consultation • W3OS & SEAL compliant • Enterprise-grade security"
} = Astro.props;
---

<section class="cta-section section">
  <div class="container">
    <div class="cta-content text-center">
      <h2 class="h2 cta-title">
        {title}
      </h2>
      <p class="body-large cta-description">
        {description} Book an operational security audit to identify and mitigate risk.
      </p>
      <div class="cta-buttons flex gap-4 justify-center">
        <a href={primaryCta.href} class="btn btn-primary btn-lg">
          {primaryCta.text}
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M6 12L10 8L6 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        {secondaryCta && (
          <a href={secondaryCta.href} class="btn btn-secondary btn-lg">
            {secondaryCta.text}
          </a>
        )}
      </div>
      {disclaimer && (
        <p class="body-small cta-disclaimer">
          {disclaimer}
        </p>
      )}
    </div>
  </div>
</section>

<style>
  .cta-section {
    padding: var(--spacing-3) 0;
    background: var(--color-background-primary);
  }
  
  .cta-content {
    max-width: 800px;
    margin: 0 auto;
    padding: var(--spacing-3) var(--spacing-4);
    background: var(--color-background-secondary);
    border: 1px solid var(--color-border-primary);
    border-radius: var(--radius-lg);
    transition: all var(--transition-base);
    position: relative;
    z-index: 1;
  }
  
  .cta-content:hover {
    border-color: rgba(139, 92, 246, 0.15);
    box-shadow: 0 2px 8px rgba(124, 58, 237, 0.15);
    transform: translateY(-2px);
  }
  
  .cta-title {
    margin-bottom: var(--spacing-4);
    color: var(--color-text-primary);
    background: linear-gradient(135deg, var(--color-text-primary) 0%, var(--color-primary-300) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  
  .cta-description {
    margin-bottom: var(--spacing-10);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }
  
  .cta-buttons {
    display: flex;
    gap: var(--spacing-3);
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: var(--spacing-2); /* Consistent: buttons → disclaimer */
  }
  
  .cta-disclaimer {
    color: var(--color-text-secondary);
    opacity: 0.8;
    margin-top: 0;
    margin-bottom: 0;
  }
  
  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-2);
    padding: var(--spacing-4) var(--spacing-6);
    border-radius: var(--radius-lg);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
    transition: all var(--transition-base);
    cursor: pointer;
    border: none;
    font-family: inherit;
  }
  
  .cta-buttons .btn-primary {
    background: rgb(125, 70, 190);
    color: #FFFFFF;
    border: none;
    border-radius: var(--radius-full);
    box-shadow: none;
    transition: background 175ms ease-out;
  }
  
  .cta-buttons .btn-primary:hover {
    background: rgb(150, 86, 220);
    transition: background 175ms ease-out;
  }

  .cta-buttons .btn-primary:active {
    background: rgb(112, 62, 175);
    transition: background 150ms ease-out;
  }
  
  .cta-buttons .btn-primary:focus {
    outline: none;
  }
  
  .cta-buttons .btn-primary:focus-visible {
    outline: 2px solid var(--color-primary-400);
    outline-offset: 2px;
  }
  
  .cta-buttons .btn-secondary {
    background: #12091F;
    color: #FFFFFF;
    border: 1px solid rgba(168, 85, 247, 0.4);
    border-radius: var(--radius-full);
    backdrop-filter: none;
  }
  
  .cta-buttons .btn-secondary:hover {
    background: #1A0F2E;
    border-color: rgba(168, 85, 247, 0.55);
  }
  
  .cta-buttons .btn-secondary:focus {
    outline: none;
  }
  
  .btn-secondary:hover {
    background: var(--color-background-secondary);
    border-color: var(--color-primary-400);
  }
  
  .btn-lg {
    padding: var(--spacing-4) var(--spacing-8);
    font-size: var(--font-size-lg);
    border-radius: var(--radius-full);
    min-height: 48px;
  }
  
  .btn svg {
    width: 16px;
    height: 16px;
  }
  
  @media (max-width: 767px) {
    .cta-buttons {
      flex-direction: column;
      align-items: center;
    }
    
    .btn {
      width: 100%;
      max-width: 300px;
      justify-content: center;
    }
    
    .cta-title {
      font-size: var(--font-size-4xl);
    }
  }
</style>
