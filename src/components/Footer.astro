---
export interface Props {
  logo?: {
    src: string;
    alt: string;
    width?: number;
  };
  links?: Array<{
    text: string;
    href: string;
  }>;
  socials?: Array<{
    name: string;
    href: string;
    icon: string;
  }>;
}

const { 
  logo = {
    src: "/images/Logo-hi-vis.png",
    alt: "Auditware Logo",
    width: 182
  },
  links = [
    { text: "About Us", href: "/about" },
    { text: "FAQ", href: "/faq" },
    { text: "Partnerships", href: "/partnerships" },
  ],
  socials = [
    {
      name: "Discord",
      href: "https://discord.gg/wefVH8NYbb",
      icon: `<svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.095 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.095 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>`
    },
    {
      name: "X (Twitter)",
      href: "https://twitter.com/audit_wizard",
      icon: `<svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>`
    },
    {
      name: "LinkedIn",
      href: "https://www.linkedin.com/company/auditwareio/",
      icon: `<svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`
    }
  ]
} = Astro.props;
---

<footer class="footer">
  <div class="container">
    <div class="footer-wrapper">
      <a href="/" class="footer-brand">
        <img 
          src={logo.src} 
          loading="lazy" 
          width={logo.width} 
          alt={logo.alt} 
          class="footer-brand-image" 
        />
      </a>
      <div class="footer-links">
        {links.map((link) => (
          <a href={link.href} class="footer-link">
            {link.text}
          </a>
        ))}
      </div>
      <div class="footer-socials">
        {socials.map((social) => (
          <a
            href={social.href}
            class="footer-social-link"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={social.name}
          >
            <Fragment set:html={social.icon} />
          </a>
        ))}
      </div>
      <div class="footer-copyright">
        &copy; {new Date().getFullYear()} Auditware
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: var(--spacing-8) 0;
    background: rgba(10, 10, 10, 0.6);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    position: relative;
  }
  
  .footer::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-primary-500), transparent);
    opacity: 0.3;
  }
  
  .footer-wrapper {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--spacing-8);
  }
  
  .footer-brand {
    display: flex;
    align-items: center;
    text-decoration: none;
    transition: opacity var(--transition-base);
  }
  
  .footer-brand:hover {
    opacity: 0.85;
  }
  
  .footer-brand-image {
    height: auto;
    max-width: 140px;
  }
  
  .footer-links {
    display: flex;
    gap: var(--spacing-6);
    align-items: center;
  }
  
  .footer-link {
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: var(--font-size-sm);
    transition: all var(--transition-base);
    white-space: nowrap;
  }

  /* Mobile/tablet-only: prevent horizontal overflow — allow links to wrap when many in a row. */
  @media (max-width: 768px) {
    .footer-link {
      white-space: normal;
      overflow-wrap: break-word;
    }
    .footer-copyright {
      white-space: normal;
    }
  }
  
  .footer-link:hover {
    color: var(--color-primary-400);
  }

  .footer-socials {
    display: flex;
    align-items: center;
    gap: var(--spacing-4);
  }

  .footer-social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    color: var(--color-text-tertiary);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.06);
    transition: all var(--transition-base);
  }

  .footer-social-link:hover {
    color: var(--color-primary-400);
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(var(--color-primary-raw, 139, 92, 246), 0.3);
    transform: translateY(-1px);
  }

  .footer-social-link :global(svg) {
    width: 18px;
    height: 18px;
  }
  
  .footer-copyright {
    color: var(--color-text-tertiary);
    font-size: var(--font-size-sm);
    white-space: nowrap;
  }
  
  @media (max-width: 991px) {
    .footer {
      padding: var(--spacing-6) 0;
    }
    /* Mobile: prevent section box from being cut off. */
    .footer-wrapper {
      max-width: 100%;
      width: 100%;
      box-sizing: border-box;
      flex-direction: column;
      gap: var(--spacing-4);
    }
    
    .footer-links {
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--spacing-4);
    }

    .footer-socials {
      gap: var(--spacing-3);
    }
  }
  
  @media (max-width: 479px) {
    .footer {
      padding: var(--spacing-5) 0;
    }
    
    .footer-brand-image {
      max-width: 120px;
    }
    
    .footer-links {
      gap: var(--spacing-3);
    }
    
    .footer-link {
      font-size: var(--font-size-xs);
    }

    .footer-social-link {
      width: 32px;
      height: 32px;
      border-radius: 6px;
    }

    .footer-social-link :global(svg) {
      width: 16px;
      height: 16px;
    }
    
    .footer-copyright {
      font-size: var(--font-size-xs);
    }
  }
</style>
