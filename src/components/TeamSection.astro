---
const { 
  title = "About us",
  subtitle = "Security doesn't stop at code - Many hacks are due to insider threats, compromised private keys, and infrastructure security flaws.",
  teamMembers = []
} = Astro.props;
---

<section class="team-circles">
  <h1 class="heading-3">{title}</h1>
  
  <div class="container-2">
    <div class="team-grid">
      {teamMembers.map(member => (
        <div class="team-card">
          <div class="hex-avatar" data-member={member.name.toLowerCase().replace(/\s+/g, '-')}>
            <img 
              src={member.image} 
              loading="lazy" 
              width="140" 
              height="140"
              alt={member.name} 
              class="team-member-image" 
            />
          </div>
          <div class="team-member-name">{member.name}</div>
          <div class="team-member-position">{member.position}</div>
          <p class="paragraph-18">
            {member.bio}
          </p>
          <div class="footer-social-block">
            {member.social.map(link => (
              <a href={link.url} target="_blank" rel="noopener noreferrer" class="footer-social-link">
                <img 
                  src={link.icon} 
                  loading="lazy" 
                  width="24" 
                  alt={link.platform} 
                  class="image-3" 
                />
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .team-circles {
    padding: 56px 0;
    text-align: center;
    background: transparent;
    position: relative;
    overflow: hidden;
  }

  .heading-3 {
    color: #ffffff;
    position: relative;
    z-index: 1;
  }

  .text-block-9 {
    font-size: 1.25rem;
    color: #a0a0a0;
    max-width: 800px;
    margin: 0 auto 64px auto;
    line-height: 1.6;
    position: relative;
    z-index: 1;
  }

  .container-2 {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    position: relative;
    z-index: 1;
  }

  /* Mobile/tablet-only: prevent horizontal overflow — reduce padding. */
  @media (max-width: 768px) {
    .container-2 {
      padding-left: 16px;
      padding-right: 16px;
    }
  }
  @media (max-width: 480px) {
    .container-2 {
      padding-left: 12px;
      padding-right: 12px;
    }
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 48px;
    justify-items: center;
  }

  /* Mobile/tablet-only: prevent horizontal overflow — minmax(320px) exceeds 320px viewport with padding; single column + min-width:0. */
  @media (max-width: 1024px) {
    .team-grid {
      grid-template-columns: 1fr;
      min-width: 0;
    }
    .team-card {
      max-width: 100%;
      min-width: 0;
    }
  }
  @media (max-width: 480px) {
    .team-grid {
      gap: 24px;
    }
  }

  .team-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 32px;
    text-align: center;
    max-width: 400px;
    width: 100%;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    backdrop-filter: blur(8px);
    display: flex;
    flex-direction: column;
  }

  .team-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 25px rgba(107, 33, 168, 0.15);
    border-color: rgba(107, 33, 168, 0.3);
  }

  /* Regular hexagon shape (flat top) - Single shared wrapper for all avatars */
  .hex-avatar {
    width: 140px;
    height: 140px;
    aspect-ratio: 1 / 1;
    margin: 0 auto 24px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
    box-sizing: border-box;
    clip-path: polygon(25% -3%, 75% -3%, 100% 50%, 75% 98%, 25% 98%, 0% 50%);
  }
  
  .hex-avatar::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    clip-path: polygon(25% -3%, 75% -3%, 100% 50%, 75% 98%, 25% 98%, 0% 50%);
    border: 2px solid rgba(255, 255, 255, 0.1);
    pointer-events: none;
    z-index: 1;
  }
  
  /* Baseline image styling - identical for all, fixed computed size */
  .team-member-image {
    width: 140px;
    height: 140px;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    object-position: center;
    border-radius: 0;
    flex-shrink: 0;
    display: block;
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }
  
  /* Per-image adjustments - only object-position for cropping, no size/transform changes */
  .hex-avatar[data-member="joe-van-loon"] .team-member-image {
    object-position: center;
  }
  
  .hex-avatar[data-member="tomer-bar"] .team-member-image {
    object-position: center;
  }
  
  .hex-avatar[data-member="ken-murillo"] .team-member-image {
    object-position: center;
  }

  .team-member-name {
    font-size: 1.5rem;
    font-weight: bold;
    color: #ffffff;
    margin-bottom: 8px;
  }

  .team-member-position {
    font-size: 1rem;
    color: #6b21a8;
    font-weight: 700;
    margin-bottom: 16px;
  }

  .paragraph-18, .paragraph-22 {
    color: #a0a0a0;
    line-height: 1.6;
    margin-bottom: 0;
    font-size: 1rem;
    flex: 1;
  }

  .footer-social-block {
    display: flex;
    justify-content: center;
    gap: 16px;
    margin-top: auto;
    padding-top: 24px;
  }

  .footer-social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: background-color 0.3s ease, transform 0.3s ease, border-color 0.3s ease;
  }

  .footer-social-link:hover {
    background: rgba(107, 33, 168, 0.2);
    border-color: rgba(107, 33, 168, 0.4);
    transform: translateY(-2px);
  }

  .image-3 {
    filter: brightness(0) invert(1);
  }

  @media (max-width: 767px) {
    .team-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    
    .heading-3 {
      font-size: 2.5rem;
    }
    
    .text-block-9 {
      font-size: 1.125rem;
    }
  }
</style>
