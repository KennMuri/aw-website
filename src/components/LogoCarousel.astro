---
import { Image } from 'astro:assets';

export interface Props {
  title?: string;
  subtitle?: string;
  logos: Array<{
    name: string;
    src: string;
    width?: number;
    height?: number;
  }>;
}

const { title, subtitle, logos } = Astro.props;
---

<section class="logo-carousel section-sm">
  <div class="container">
    {(title || subtitle) && (
      <div class="logo-carousel-header text-center">
        {subtitle && (
          <p class="body-small text-muted">{subtitle}</p>
        )}
        {title && (
          <h2 class="h4">{title}</h2>
        )}
      </div>
    )}
    
    <div class="logo-carousel-container" id="logo-carousel-container">
      <div class="logo-carousel-track" id="logo-carousel-track">
        {logos.concat(logos).map((logo, index) => (
          <div class="logo-carousel-item" key={`${logo.name}-${index}`}>
            {logo.src.startsWith('http') ? (
              <img 
                src={logo.src} 
                alt={logo.name}
                width={logo.width || 120}
                height={logo.height || 40}
                loading="lazy"
              />
            ) : (
              <Image 
                src={logo.src} 
                alt={logo.name}
                width={logo.width || 400}
                height={logo.height || 130}
                loading="lazy"
                format="webp"
              />
            )}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .logo-carousel {
    background: var(--color-background-primary);
    border-top: none;
    border-bottom: 1px solid var(--color-border-primary);
    overflow: hidden;
    width: 100%;
    max-width: 100%;
    padding: var(--spacing-1) 0;
    margin-top: 0;
  }
  
  .logo-carousel-header {
    margin-top: 0 !important;
    margin-bottom: 0; /* Spacing handled by heading margin-bottom */
  }
  
  .logo-carousel-container {
    margin-bottom: 0;
    width: 100%;
    max-width: 100%;
  }

  /* Mobile/tablet-only: prevent horizontal overflow — section and container stay within viewport; header text wraps. */
  @media (max-width: 1024px) {
    .logo-carousel {
      width: 100%;
      max-width: 100%;
      min-width: 0;
      margin-left: auto;
      margin-right: auto;
      box-sizing: border-box;
    }
    .logo-carousel.section-sm {
      max-width: 100vw;
    }
    .logo-carousel :global(.container) {
      width: 100%;
      max-width: 100%;
      margin-left: auto;
      margin-right: auto;
      box-sizing: border-box;
    }
    .logo-carousel-container {
      min-width: 0;
      overflow: hidden;
      width: 100%;
      max-width: 100%;
    }
    .logo-carousel-header {
      overflow-wrap: break-word;
      word-wrap: break-word;
      min-width: 0;
    }
    .logo-carousel-header .h4,
    .logo-carousel-header .body-small {
      overflow-wrap: break-word;
      word-wrap: break-word;
    }
  }
  @media (max-width: 768px) {
    .logo-carousel {
      width: 100%;
      max-width: 100%;
      min-width: 0;
      margin-left: auto;
      margin-right: auto;
      box-sizing: border-box;
    }
    .logo-carousel-container {
      min-width: 0;
      overflow: hidden;
      width: 100%;
      max-width: 100%;
    }
  }

  /* Phones only: ensure section/container cannot hold a width floor (align with 480px global overrides). */
  @media (max-width: 480px) {
    .logo-carousel {
      width: 100%;
      max-width: 100%;
      min-width: 0;
      margin-left: auto;
      margin-right: auto;
      box-sizing: border-box;
    }
    .logo-carousel.section-sm {
      max-width: 100vw;
    }
    .logo-carousel :global(.container) {
      width: 100%;
      max-width: 100%;
      margin-left: auto;
      margin-right: auto;
      box-sizing: border-box;
    }
    .logo-carousel-container {
      min-width: 0;
      overflow: hidden;
      width: 100%;
      max-width: 100%;
    }
  }
  
  .logo-carousel-header .body-small {
    margin-bottom: var(--spacing-1); /* Consistent: subtitle → title */
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wider);
    color: var(--color-text-muted);
  }
  
  
  .logo-carousel-container {
    overflow: hidden;
    mask: linear-gradient(
      to right,
      transparent 0%,
      black 10%,
      black 90%,
      transparent 100%
    );
    -webkit-mask: linear-gradient(
      to right,
      transparent 0%,
      black 10%,
      black 90%,
      transparent 100%
    );
  }
  
  .logo-carousel-track {
    display: flex;
    align-items: center;
    gap: 80px;
    width: fit-content;
    animation: scroll-horizontal 40s linear infinite;
    --animation-speed: 1;
  }
  
  .logo-carousel-track.slow {
    animation-duration: 120s;
  }
  
  .logo-carousel-item {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 160px;
    min-width: 380px;
  }
  
  .logo-carousel-item:hover {
    opacity: 1;
  }
  
  .logo-carousel-item img {
    height: 130px;
    width: auto;
    min-height: 130px;
    max-height: 130px;
    filter: grayscale(100%) brightness(1.2);
    object-fit: contain;
    transition: filter var(--transition-base);
  }
  
  .logo-carousel-item:hover img {
    filter: grayscale(0%) brightness(1);
  }
  
  @keyframes scroll-horizontal {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  
  /* Responsive Design */
  @media (max-width: 767px) {
    .logo-carousel-track {
      gap: 60px;
      animation-duration: 30s;
    }
    
    .logo-carousel-track.slow {
      animation-duration: 90s;
    }
    
    .logo-carousel-item {
      height: 120px;
      min-width: 280px;
    }
    
    .logo-carousel-item img {
      height: 110px;
      min-height: 110px;
      max-height: 110px;
    }
  }
  
  @media (max-width: 479px) {
    .logo-carousel-track {
      gap: 40px;
      animation-duration: 25s;
    }
    
    .logo-carousel-track.slow {
      animation-duration: 75s;
    }
    
    .logo-carousel-item {
      height: 110px;
      min-width: 240px;
    }
    
    .logo-carousel-item img {
      height: 100px;
      min-height: 100px;
      max-height: 100px;
    }
  }

  /* Mobile/tablet-only: prevent horizontal overflow — on very narrow viewports (e.g. 320px) item min-width 240px plus padding can exceed width; section clips track but smaller items improve fit. */
  @media (max-width: 480px) {
    .logo-carousel-item {
      min-width: 140px;
      height: 100px;
    }
    .logo-carousel-item img {
      height: 80px;
      min-height: 80px;
      max-height: 80px;
    }
    .logo-carousel-track {
      gap: 24px;
    }
  }
</style>

<script>
  (function() {
    const container = document.getElementById('logo-carousel-container');
    const track = document.getElementById('logo-carousel-track');
    
    if (!container || !track) return;
    
    let animation: Animation | null = null;
    let currentProgress = 0;
    let isHovering = false;
    
    // Get the current animation
    const animations = track.getAnimations();
    if (animations.length > 0) {
      animation = animations[0] as Animation;
    }
    
    function updateSpeed() {
      if (!animation) return;
      
      // Get current progress before changing speed
      currentProgress = (animation.currentTime || 0) / (animation.effect?.getComputedTiming().duration || 40000);
      
      if (isHovering) {
        // Slow down: calculate new duration to maintain position
        const baseDuration = window.innerWidth <= 479 ? 25000 : window.innerWidth <= 767 ? 30000 : 40000;
        const slowDuration = window.innerWidth <= 479 ? 75000 : window.innerWidth <= 767 ? 90000 : 120000;
        
        // Set new duration and adjust currentTime to maintain visual position
        animation.effect?.updateTiming({ duration: slowDuration });
        animation.currentTime = currentProgress * slowDuration;
        track.classList.add('slow');
      } else {
        // Speed up: calculate new duration to maintain position
        const baseDuration = window.innerWidth <= 479 ? 25000 : window.innerWidth <= 767 ? 30000 : 40000;
        const slowDuration = window.innerWidth <= 479 ? 75000 : window.innerWidth <= 767 ? 90000 : 120000;
        
        // Get current progress from slow animation
        if (track.classList.contains('slow')) {
          currentProgress = (animation.currentTime || 0) / slowDuration;
        }
        
        // Set base duration and adjust currentTime
        animation.effect?.updateTiming({ duration: baseDuration });
        animation.currentTime = currentProgress * baseDuration;
        track.classList.remove('slow');
      }
    }
    
    container.addEventListener('mouseenter', () => {
      isHovering = true;
      updateSpeed();
    });
    
    container.addEventListener('mouseleave', () => {
      isHovering = false;
      updateSpeed();
    });
  })();
</script>
