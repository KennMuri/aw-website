---
import '../styles/tokens.css';
import '../styles/global.css';
import SiteBackground from '../components/SiteBackground.astro';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  structuredData?: any;
  googleAnalyticsId?: string;
  frontmatter?: {
    title?: string;
    description?: string;
    image?: string;
    canonical?: string;
    structuredData?: any;
    googleAnalyticsId?: string;
  };
}

// Handle both direct props and MDX frontmatter
const props = Astro.props;
const frontmatter = props.frontmatter || {};
const title = props.title || frontmatter.title || "Auditware";
const description = props.description || frontmatter.description || "Operational security audits for web3 organizations, active compromise monitoring, and rapid incident response.";
const image = props.image || frontmatter.image || "/images/og/og-default.png";
const canonical = props.canonical || frontmatter.canonical;
const structuredData = props.structuredData || frontmatter.structuredData;
const googleAnalyticsId = props.googleAnalyticsId || frontmatter.googleAnalyticsId;

// Construct canonical URL - use provided canonical or generate from current URL
const siteUrl = 'https://auditware.io';
const canonicalUrl = canonical || new URL(Astro.url.pathname, siteUrl).toString();
const imageUrl = image.startsWith('http') ? image : new URL(image, siteUrl).toString();

// Default Organization Schema
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Auditware",
  "url": siteUrl,
  "logo": new URL("/images/Monitoring.png", siteUrl).toString(),
  "description": "Premier Web3 operational security audits, smart contract audits, and the Sentry OpSec monitoring platform.",
  "foundingDate": "2020",
  "sameAs": [
    "https://twitter.com/auditware",
    "https://linkedin.com/company/auditware"
  ],
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "Sales",
    "url": `${siteUrl}/audits`
  }
};

// Website Schema for site search
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Auditware",
  "url": siteUrl,
  "description": description,
  "publisher": {
    "@type": "Organization",
    "name": "Auditware"
  }
};

// Combine schemas
const allSchemas = [organizationSchema, websiteSchema];
if (structuredData) {
  allSchemas.push(structuredData);
}

// PostHog: public env vars (fail safely if missing)
const posthogKey = typeof import.meta.env.PUBLIC_POSTHOG_KEY === 'string' ? import.meta.env.PUBLIC_POSTHOG_KEY : '';
const posthogHost = typeof import.meta.env.PUBLIC_POSTHOG_HOST === 'string' ? import.meta.env.PUBLIC_POSTHOG_HOST : '';
const posthogEnabled = posthogKey.length > 0 && posthogHost.length > 0;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#000000" />
  <title>{title}</title>
  <meta name="description" content={description} />
  
  <!-- Canonical URL -->
  <link rel="canonical" href={canonicalUrl} />
  
  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={imageUrl} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Auditware" />
  <meta property="og:locale" content="en_US" />
  
  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@auditware" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageUrl} />
  
  <!-- Structured Data (JSON-LD) -->
  <script type="application/ld+json" set:html={JSON.stringify(allSchemas)} />
  
  <!-- Favicon -->
  <link href="/images/favicon.png" rel="shortcut icon" type="image/x-icon" />
  <link href="/images/webclip.png" rel="apple-touch-icon" />
  
  <!-- DNS Prefetch & Preconnect for Performance -->
  <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
  <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
  <link rel="dns-prefetch" href="https://www.google-analytics.com" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  
  <!-- Fonts - Optimized Loading with display=swap -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
  
  <!-- Google Analytics -->
  {googleAnalyticsId && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${googleAnalyticsId}`}></script>
      <script define:vars={{ googleAnalyticsId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', googleAnalyticsId);
      </script>
    </>
  )}

  <!-- PostHog (only when env vars set) -->
  {posthogEnabled && (
    <script define:vars={{ posthogKey, posthogHost }} is:inline>
      !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagPayload isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey getNextSurveyStep identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException loadToolbar get_property getSessionProperty createPersonProfile opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing clear_opt_in_out_capturing debug".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
      // Ensure identity continuity across `auditware.io` and subdomains like `sentry.auditware.io`.
      posthog.init(posthogKey, { api_host: posthogHost, cross_subdomain_cookie: true });
    </script>
  )}
</head>
<body>
  <SiteBackground />
  <slot />
  
  <script>
    // Scroll reveal animations
    const observerOptions = {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('active');
        }
      });
    }, observerOptions);

    // Observe all elements with the reveal class
    document.addEventListener('DOMContentLoaded', () => {
      const revealElements = document.querySelectorAll('.reveal');
      revealElements.forEach(el => observer.observe(el));
      
      // Add scroll shadow to navbar
      const navbar = document.querySelector('.fixed-navbar');
      if (navbar) {
        window.addEventListener('scroll', () => {
          if (window.scrollY > 20) {
            navbar.classList.add('scrolled');
          } else {
            navbar.classList.remove('scrolled');
          }
        });
      }
    });
  </script>

  <!-- Referral attribution: persist ref from URL, rewrite tracked outbound hrefs, outbound_click -->
  <script is:inline>
    (function(){
      var REF_PARAM = 'ref';
      var STORAGE_INITIAL = 'aw_initial_ref';
      var STORAGE_INITIAL_TS = 'aw_initial_ref_ts';
      var STORAGE_SESSION = 'aw_session_ref';
      var TRACKED_HOSTS = ['calendly.com', 'sentry.auditware.io', 'docs.sentry.auditware.io'];

      function getRefFromUrl() {
        var params = new URLSearchParams(window.location.search);
        return params.get(REF_PARAM) || null;
      }
      function getStoredRef() {
        try {
          return sessionStorage.getItem(STORAGE_SESSION) || localStorage.getItem(STORAGE_INITIAL) || null;
        } catch (e) { return null; }
      }
      function persistRef(ref) {
        if (!ref) return;
        try {
          localStorage.setItem(STORAGE_INITIAL, ref);
          localStorage.setItem(STORAGE_INITIAL_TS, String(Date.now()));
          sessionStorage.setItem(STORAGE_SESSION, ref);
        } catch (e) {}
      }
      function isTrackedOutbound(href) {
        try {
          var u = new URL(href);
          return TRACKED_HOSTS.some(function(h) { return u.hostname === h || u.hostname.endsWith('.' + h); });
        } catch (e) { return false; }
      }
      function hrefHasRef(href) {
        try {
          return new URL(href).searchParams.has(REF_PARAM);
        } catch (e) { return false; }
      }
      function appendRefToHref(href, ref) {
        try {
          var u = new URL(href);
          if (u.searchParams.has(REF_PARAM)) return href;
          u.searchParams.set(REF_PARAM, ref);
          return u.toString();
        } catch (e) { return href; }
      }

      var refCode = getRefFromUrl();
      if (refCode) {
        persistRef(refCode);
        setTimeout(function() {
          if (window.posthog) window.posthog.capture('referral_landing', {
            ref: refCode,
            ref_code: refCode,
            $set_once: { ref_code: refCode }
          });
        }, 100);
      }

      function applyRefToTrackedLinks() {
        var ref = getStoredRef();
        if (!ref) return;
        document.querySelectorAll('a[href^="http"]').forEach(function(a) {
          var href = a.getAttribute('href');
          if (!href || !isTrackedOutbound(href) || hrefHasRef(href)) return;
          a.setAttribute('href', appendRefToHref(href, ref));
        });
      }

      function handleOutboundClick(e) {
        var a = e.target && e.target.closest ? e.target.closest('a') : null;
        if (!a || !a.href) return;
        try {
          var u = new URL(a.href);
          if (u.hostname === window.location.hostname) return;
          if (!TRACKED_HOSTS.some(function(h) { return u.hostname === h || u.hostname.endsWith('.' + h); })) return;
          if (window.posthog) window.posthog.capture('outbound_click', { url: a.href, domain: u.hostname });
        } catch (err) {}
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', applyRefToTrackedLinks);
      } else {
        applyRefToTrackedLinks();
      }
      document.addEventListener('click', handleOutboundClick);
    })();
  </script>
</body>
</html>

<style is:global>
  /* Global Styles */
  * {
    box-sizing: border-box;
  }

  body {
    color: #fff;
    background: transparent;
    font-family: var(--font-family-body);
    font-size: 14px;
    line-height: 1.2;
    margin: 0;
    padding: 0;
    position: relative;
  }
  
  body > * {
    position: relative;
    z-index: 1;
  }

  h1 {
    margin-top: 20px;
    margin-bottom: 0;
    font-size: var(--font-size-10xl);
    font-weight: 500;
    line-height: 0.9;
    color: #fff;
  }

  h2 {
    margin-top: 20px;
    margin-bottom: 10px;
    font-size: var(--font-size-7xl);
    font-weight: 500;
    line-height: 1.2;
    color: #fff;
  }

  h3 {
    margin-top: 20px;
    margin-bottom: 10px;
    font-size: var(--font-size-6xl);
    font-weight: 500;
    line-height: 1.2;
    color: #fff;
  }

  h4 {
    margin-top: 10px;
    margin-bottom: 10px;
    font-size: var(--font-size-4xl);
    font-weight: 500;
    line-height: 1.2;
    color: #fff;
  }

  h5 {
    margin-top: 10px;
    margin-bottom: 10px;
    font-size: var(--font-size-5xl);
    font-weight: 500;
    line-height: 1.2;
    color: #fff;
  }

  h6 {
    margin-top: 10px;
    margin-bottom: 10px;
    font-size: var(--font-size-3xl);
    font-weight: 500;
    line-height: 1.2;
    color: #fff;
  }

  p {
    color: #fff;
    margin-bottom: 10px;
    font-family: var(--font-family-body);
    font-size: var(--font-size-base);
    font-weight: 400;
    line-height: 1.3;
  }

  a {
    color: #fff;
    text-decoration: none;
  }

  img {
    max-width: 100%;
    display: inline-block;
  }

  /* Container utility */
  .container {
    width: 100%;
    max-width: var(--max-width-container);
    margin: 0 auto;
    padding: 0 2em;
  }

  /* Mobile/tablet-only: prevent horizontal overflow — constrain container so document width stays at viewport (no html scrollWidth > innerWidth). */
  @media (max-width: 1024px) {
    .container {
      width: 100%;
      max-width: 100%;
      margin-left: auto;
      margin-right: auto;
      padding-left: 20px;
      padding-right: 20px;
      box-sizing: border-box;
    }
  }
  @media (max-width: 768px) {
    .container {
      padding-left: 16px;
      padding-right: 16px;
    }
  }
  @media (max-width: 480px) {
    .container {
      padding-left: 12px;
      padding-right: 12px;
    }
  }

  /* Responsive typography */
  @media screen and (max-width: 991px) {
    h1 { font-size: var(--font-size-7xl); }
    h2 { font-size: var(--font-size-6xl); }
    h3 { font-size: var(--font-size-5xl); }
    h4 { font-size: var(--font-size-4xl); }
    h5 { font-size: var(--font-size-3xl); }
    h6 { font-size: var(--font-size-2xl); }
  }

  @media screen and (max-width: 767px) {
    h1 { font-size: var(--font-size-5xl); }
    h2 { font-size: var(--font-size-4xl); }
    h3 { font-size: var(--font-size-3xl); }
    h4 { font-size: var(--font-size-2xl); }
    h5 { font-size: var(--font-size-2xl); }
    h6 { font-size: var(--font-size-xl); }
  }
</style>
