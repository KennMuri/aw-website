---
import '../styles/tokens.css';
import '../styles/global.css';
import SiteBackground from '../components/SiteBackground.astro';

const props = Astro.props;
const frontmatter = props.frontmatter || {};
const title = props.title || frontmatter.title || 'W3OS';
const description = props.description || frontmatter.description || 'Web3 Operational Security Standard — open standard for operational security in Web3.';
const image = props.image || frontmatter.image || '/og-default.png';
const canonical = props.canonical || frontmatter.canonical;

const siteUrl = 'https://w3os.dev';
const canonicalUrl = canonical || new URL(Astro.url.pathname, siteUrl).toString();
const imageUrl = image.startsWith('http') ? image : new URL(image, siteUrl).toString();
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#000000" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={imageUrl} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="W3OS" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageUrl} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
</head>
<body>
  <SiteBackground />
  <slot />
</body>
</html>
