---
export interface Props {
  title: string;
  subtitle?: string;
  description?: string;
  centered?: boolean;
}

const { title, subtitle, description, centered = true } = Astro.props;
---

<div class={`section-intro ${centered ? 'section-intro--centered' : ''}`}>
  {subtitle && <p class="section-intro__eyebrow">{subtitle}</p>}
  <h2 class="section-intro__title">{title}</h2>
  {description && <p class="section-intro__description">{description}</p>}
</div>

<style>
  .section-intro {
    margin-bottom: var(--spacing-8);
  }
  .section-intro--centered {
    text-align: center;
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: var(--spacing-8);
  }
  .section-intro__eyebrow {
    font-size: 0.875rem;
    font-weight: var(--font-weight-medium);
    color: var(--color-accent-500);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--spacing-2);
  }
  .section-intro__title {
    font-size: var(--font-size-4xl);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-tight);
    color: var(--color-text-primary);
    margin: 0 0 var(--spacing-4) 0;
  }
  .section-intro__description {
    font-size: var(--font-size-lg);
    line-height: var(--line-height-normal);
    color: var(--color-text-secondary);
    margin: 0;
  }
  @media (max-width: 768px) {
    .section-intro__title {
      font-size: var(--font-size-2xl);
    }
  }
</style>
