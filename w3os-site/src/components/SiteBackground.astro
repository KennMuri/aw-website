---
import { w3osTheme } from '../styles/themes.ts';

const { palette } = w3osTheme;
const g1 = palette.semantic.background.gradient1;
const g2 = palette.semantic.background.gradient2;
const g3 = palette.semantic.background.gradient3;
---

<div class="site-background">
  <div
    class="site-background-gradient-1"
    style={`background: radial-gradient(ellipse, rgba(${g1.color}, ${g1.opacity}) 0%, transparent 70%); top: -18%; left: -35%; width: 82%; height: 108%; position: absolute; pointer-events: none;`}
  ></div>
  <div
    class="site-background-gradient-2"
    style={`background: radial-gradient(ellipse, rgba(${g2.color}, ${g2.opacity}) 0%, transparent 70%); bottom: -20%; right: -30%; width: 70%; height: 80%; position: absolute; pointer-events: none;`}
  ></div>
  <div
    class="site-background-gradient-3"
    style={`background: radial-gradient(circle, rgba(${g3.color}, ${g3.opacity}) 0%, transparent 75%); top: 48%; left: 35%; width: 52%; height: 62%; position: absolute; pointer-events: none;`}
  ></div>
  <div class="site-background-dots"></div>
</div>

<style>
  .site-background {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: -1;
    background: #000000;
  }
  .site-background-gradient-1,
  .site-background-gradient-2,
  .site-background-gradient-3 {
    position: absolute;
    z-index: 0;
  }
  .site-background-dots {
    position: absolute;
    inset: 0;
    opacity: 0.12;
    background-image: radial-gradient(circle at 25px 25px, rgba(255, 255, 255, 0.35) 2px, transparent 0);
    background-size: 50px 50px;
    pointer-events: none;
    z-index: 2;
  }
</style>
