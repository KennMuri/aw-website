---
export interface Level {
  name: string;
  description: string;
}

export interface Props {
  levels: Level[];
}

const { levels } = Astro.props;
---

<div class="maturity-levels">
  {levels.map((level, i) => (
    <div class="maturity-level">
      <span class="maturity-level__number">{i + 1}</span>
      <div class="maturity-level__content">
        <h3 class="maturity-level__name">{level.name}</h3>
        <p class="maturity-level__description">{level.description}</p>
      </div>
    </div>
  ))}
</div>

<style>
  .maturity-levels {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-6);
  }
  .maturity-level {
    display: flex;
    gap: var(--spacing-5);
    align-items: flex-start;
    padding: var(--spacing-5);
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--color-border-primary);
    border-radius: var(--radius-xl);
  }
  .maturity-level__number {
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-border-accent);
    color: var(--color-text-primary);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    border-radius: var(--radius-md);
  }
  .maturity-level__content {
    flex: 1;
  }
  .maturity-level__name {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    margin: 0 0 var(--spacing-2) 0;
  }
  .maturity-level__description {
    font-size: var(--font-size-base);
    line-height: var(--line-height-normal);
    color: var(--color-text-secondary);
    margin: 0;
  }
</style>
