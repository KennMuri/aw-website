---
export interface Props {
  id?: string;
  title?: string;
  description?: string;
  centered?: boolean;
  class?: string;
}

const { id, title, description, centered = true, class: className } = Astro.props;
---

<section class={`content-section section ${className ?? ''}`} id={id}>
  <div class="container">
    {title && (
      <div class={`content-section__header ${centered ? 'content-section__header--centered' : ''}`}>
        <h2 class="content-section__title">{title}</h2>
        {description && <p class="content-section__description">{description}</p>}
      </div>
    )}
    <div class="content-section__body">
      <slot />
    </div>
  </div>
</section>

<style>
  .content-section {
    padding: var(--spacing-8) 0;
  }
  .content-section__header {
    margin-bottom: var(--spacing-6);
  }
  .content-section__header--centered {
    text-align: center;
    max-width: 640px;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: var(--spacing-6);
  }
  .content-section__title {
    font-size: var(--font-size-4xl);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-tight);
    color: var(--color-text-primary);
    margin: 0 0 var(--spacing-4) 0;
  }
  .content-section__description {
    font-size: var(--font-size-lg);
    line-height: var(--line-height-normal);
    color: var(--color-text-secondary);
    margin: 0;
  }
  .content-section__body :global(p) {
    margin-bottom: var(--spacing-4);
    color: var(--color-text-secondary);
    line-height: var(--line-height-normal);
  }
  .content-section__body :global(p:last-child) {
    margin-bottom: 0;
  }
  @media (max-width: 768px) {
    .content-section__title {
      font-size: var(--font-size-2xl);
    }
  }
</style>
